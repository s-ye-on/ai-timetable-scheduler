# 서버의 별도 환경파일로 복사하고 chmod 600 적용. 실제 값은 Git에 넣지 않는다.
COMPOSE_PROJECT_NAME=campus-planner
IMAGE_TAG=local
H2_DATA_DIR=/srv/campus-planner/data
ACME_WEBROOT=/srv/campus-planner/acme
TLS_CERT_DIR=/srv/campus-planner/certs
H2_DB_USERNAME=sa
H2_DB_PASSWORD=

# openssl rand -hex 32로 한 번 생성한 값을 지속적으로 사용한다.
APP_JWT_SECRET=
OPENAI_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://campusplanner.duckdns.org/api/calendar/oauth/callback

OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 운영 기본값. 로컬 격리 검증만 127.0.0.1 및 사용하지 않는 포트로 변경한다.
WEB_BIND_ADDRESS=0.0.0.0
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
APP_MEMORY_LIMIT=1280m
WEB_MEMORY_LIMIT=128m
JAVA_TOOL_OPTIONS=-Xms128m -Xmx768m -XX:MaxMetaspaceSize=256m -XX:+ExitOnOutOfMemoryError
